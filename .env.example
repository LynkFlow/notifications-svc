SERVICE_NAME=notification-svc
DATABASE_URL=postgresql://app_user:percent_encoded_password@localhost:5432/LynkFlow
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_EMAIL=your_verified_sender@example.com
SMTP_FROM_NAME=LynkFlow
SMTP_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SEND_TIMEOUT_MS=10000
