{
  "name": "notification-svc",
  "version": "1.0.0",
  "private": true,
  "description": "LynkFlow transactional email notification microservice",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "dev": "nodemon --watch index.ts --watch app.ts --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "db:migrate": "npm run build && npm run db:migrate:production",
    "db:migrate:production": "node dist/scripts/migrate.js",
    "test": "npm run build:test && node --test --test-concurrency=1 dist-test/test/app.test.js dist-test/test/templateRenderer.test.js dist-test/test/sendEmailValidator.test.js",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "typescript": "7.0.2"
  }
}
